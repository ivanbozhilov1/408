{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unit408/accepted-gallery-release/v1",
  "type": "object",
  "required": ["schema", "galleryHead", "acceptedAt", "contract", "nativeInputs", "sourceImages", "preference", "candidateGate", "review", "productBindings", "views"],
  "properties": {
    "schema": {"const": 1},
    "galleryHead": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "targetHead": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "acceptedAt": {"type": "string", "format": "date-time"},
    "contract": {"$ref": "#/$defs/file"},
    "review": {"$ref": "#/$defs/file"},
    "nativeInputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "sourceImages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "preference": {"type": "object", "required": ["revision", "checkedRevision", "exclusionRevision", "checkedExclusionRevision"]},
    "candidateGate": {"type": "object", "required": ["checkerSha256", "preferencesSha256", "preferenceRevision", "brief", "candidates", "result"], "properties": {"brief": {"$ref": "#/$defs/file"}, "candidates": {"$ref": "#/$defs/file"}, "result": {"$ref": "#/$defs/file"}}},
    "productBindings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["catalogueId", "candidateId", "photoSha256"]}},
    "views": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "designId", "sourcePath", "sourceSha256", "destination", "productIds", "width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "productIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}},
    "publicFiles": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/file"}, {"required": ["destination"]}]}}
  },
  "$defs": {"file": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
}
